{
  "name": "midnight-recorder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/desktop/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1",
    "cli": "node src/agent/cli.js",
    "mcp": "node src/agent/mcp.js",
    "verify:desktop": "node --test --test-concurrency=1 acceptance/desktop.mjs",
    "format": "prettier --write src test acceptance package.json README.md QA.md PLAN.md AGENTS.md"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
